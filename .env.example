# URL base da API do backend integrador (quando existir).
# Se vazio/ausente, o front usa a camada mock (src/data/mock.ts).
VITE_API_URL=

# Token Bearer enviado ao backend (opcional; deve casar com API_TOKEN do server).
VITE_API_TOKEN=

# Credenciais de acesso ao dashboard (fase mock — trocar por auth real no backend).
VITE_LOGIN_USER=admin
VITE_LOGIN_PASS=iazan
