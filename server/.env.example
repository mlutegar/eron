# Porta HTTP do backend integrador.
PORT=3001

# Token Bearer exigido nas rotas (opcional). Vazio = API aberta.
# Deve casar com VITE_API_TOKEN do front.
API_TOKEN=

# Origens permitidas no CORS (separadas por virgula). "*" libera todas.
ALLOWED_ORIGIN=*

# Intervalo do agendador de sincronizacao, em minutos.
SYNC_INTERVAL_MIN=10

# --- OAuth2 Conta Azul (NUNCA commitar valores reais; use server/.env) ---
CA_CLIENT_ID=
CA_CLIENT_SECRET=
# Deve casar EXATAMENTE com o redirect_uri registrado no portal de devs.
CA_REDIRECT_URI=http://localhost:3001/oauth/contaazul/callback
# Endpoints/escopos segundo a documentacao atual da Conta Azul.
CA_AUTHORIZE_URL="https://login.contaazul.com/#/oauth/authorize"
CA_TOKEN_URL=https://api-v2.contaazul.com/oauth/token
CA_SCOPE=openid profile aws.cognito.signin.user.admin
CA_API_BASE=https://api-v2.contaazul.com
CA_PUBLIC_BASE=https://public.contaazul.com
# Banco SQLite do robo (gitignored). Em prod: /data/eron.db (volume Docker).
DB_PATH=.eron.db

# Caminho do arquivo de tokens persistidos (gitignored).
CA_TOKENS_PATH=.tokens.json

# --- Questor Zen (token gerado em Minha Conta > Token API) ---
ZEN_BASE_URL=https://assejurc.app.questorpublico.com.br
ZEN_API_TOKEN=

# Segredo que assina as sessoes do painel (login). Gere com o mesmo comando abaixo.
# Usuarios: npm run usuario -- criar <login>
SESSION_SECRET=

# Chave para cifrar os tokens em repouso (AES-256-GCM). Vazio = texto puro (so dev).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# Alertas ativos (opcional): webhook (Slack/Discord/generico) p/ falhas de OAuth/sync.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MIN=30

# --- E-mails de operacao (Resend). Vazio = so log. Destinatarios: settings do robo (painel/API).
RESEND_API_KEY=
EMAIL_REMETENTE="IAZAN Sync <robo@avisos.iazan.com.br>"
